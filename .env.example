# CYBOS 원본 parquet (앱에 복사하지 않고 *.bar 로 증분 변환)
# CYBOS_SRC=G:\내 드라이브\db\raw\cybos

# mock: 키움 모의투자 조회 / real: 키움 실전 조회
KIWOOM_MODE=real
KIWOOM_APP_KEY=
KIWOOM_SECRET_KEY=
# REST 요청 간 최소 간격(ms). 키움의 실제 호출 한도는 공개되어 있지 않습니다.
KIWOOM_REQUEST_INTERVAL_MS=300

# --- 중앙 REST 제한 (검증되지 않은 로컬 예산) ---
# 키움은 1700/1701/1702 오류 코드만 공개하고 수치 한도는 공개하지 않습니다.
# 아래 값은 보수적인 로컬 설정이며 키움 정책을 보장하지 않습니다.
KIWOOM_TOTAL_BURST=10
KIWOOM_API_BURST=5
KIWOOM_PENALTY_MS=1000
KIWOOM_MAX_WAIT_MS=15000

# --- 실시간(WebSocket) 제한 (검증되지 않은 로컬 예산) ---
# 공식 명세에 동시 접속/구독 최대 개수가 없어 로컬 안전 한도로 관리합니다.
KIWOOM_REALTIME_MAX_SUBSCRIPTIONS=100
KIWOOM_REALTIME_MAX_ITEMS_PER_PACKET=10
# 순위 계산을 위해 실시간 체결을 구독할 조건검색 포착 종목 수 상한
KIWOOM_QUOTE_BUDGET=40

# --- 캐시/감사 ---
CACHE_MAX_CODES=200
CANDLE_CAPACITY=1200
AUDIT_CAPACITY=2000
# 선택 종목의 분봉을 REST로 다시 확인하는 주기(ms). 실시간 체결과 별개입니다.
CANDLE_SYNC_MS=60000
# 실시간 체결이 이 시간(ms)보다 오래되면 순위에서 제외합니다. 가상 시세로 채우지 않습니다.
QUOTE_TTL_MS=30000

# --- 모의 전략 위험 한도 (로컬 정책, 키움 공개 한도 아님) ---
# 주문은 전송되지 않습니다. 메모리상 모의 진입만 제한합니다.
RISK_MAX_POSITIONS=4
RISK_MAX_ENTRIES_PER_CODE=3
RISK_MAX_ENTRIES_PER_DAY=20
RISK_MAX_CONSECUTIVE_LOSSES=3
RISK_COOLDOWN_MS=300000
RISK_MAX_DAILY_LOSS_PCT=3
RISK_START_EQUITY=10000000
RISK_MAX_ENTRIES_PER_MINUTE=10

PORT=3000
